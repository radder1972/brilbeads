                </div>

                <div class="systems-grid">
                    <!-- System 1: Silicone Slide -->
                    <div class="system-card glass">
                        <div class="system-visual">
                            <svg class="system-explain-svg" viewBox="0 0 200 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Temple -->
                                <path d="M 20 60 H 180" stroke="#333" stroke-width="12" stroke-linecap="round" />
                                <path d="M 20 60 H 180" stroke="#555" stroke-width="4" stroke-linecap="round" />
                                
