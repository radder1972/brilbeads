                                        <circle cx="340" cy="120" r="8" fill="var(--pink)" opacity="0.3" stroke="var(--pink)" stroke-width="2" stroke-dasharray="2,2" class="snap-target" />
                                        <circle cx="400" cy="120" r="8" fill="var(--pink)" opacity="0.3" stroke="var(--pink)" stroke-width="2" stroke-dasharray="2,2" class="snap-target" />
                                        <circle cx="460" cy="120" r="8" fill="var(--pink)" opacity="0.3" stroke="var(--pink)" stroke-width="2" stroke-dasharray="2,2" class="snap-target" />
                                        <circle cx="185" cy="70" r="8" fill="var(--pink)" opacity="0.3" stroke="var(--pink)" stroke-width="2" stroke-dasharray="2,2" class="snap-target-front" />
                                    </g>

                                    <!-- Active Bead Placement Group (Dynamic beads populated here by JS) -->
                                    <g id="placed-beads-layer" filter="url(#bead-shadow)">
                                        <!-- Rendered dynamically -->
                                    </g>
                                </g>
                            </svg>

                            <!-- Tooltip/Instruction Layer overlay -->
                            <div class="canvas-instruction-overlay" id="canvas-overlay">
