                                        <line id="slide-guideline" x1="260" y1="120" x2="480" y2="120" stroke="var(--teal)" stroke-width="2" stroke-dasharray="4,4" opacity="0.8" />
                                    </g>

                                    <!-- Snap locations for Zachte Clips (Visible in Clip Mode) -->
                                    <g id="clip-snap-targets" opacity="0">
